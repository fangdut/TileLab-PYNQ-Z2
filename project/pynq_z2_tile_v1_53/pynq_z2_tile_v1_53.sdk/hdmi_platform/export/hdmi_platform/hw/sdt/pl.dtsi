		regions_regs: region_axi@43c00000 {
			compatible = "xlnx,region-axi-1.0";
			status = "okay";
			clock-names = "s_axi_aclk";
			xlnx,ip-name = "region_axi";
			xlnx,edk-iptype = "PERIPHERAL";
			reg = <0x43c00000 0x1000>;
			clocks = <&clkc 15>;
			xlnx,name = "regions_regs";
		};
